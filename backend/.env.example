APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# ── Broadcasting ──
BROADCAST_CONNECTION=reverb

# ── Reverb Server ──
REVERB_APP_ID=your-app-id-here
REVERB_APP_KEY=your-app-key-here
REVERB_APP_SECRET=your-app-secret-here
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Public credentials (frontend uses these)
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME=http

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# ── Queue ──
QUEUE_CONNECTION=database
# For production: use redis
# QUEUE_CONNECTION=redis

# ── Redis (Required for Horizon and production queues) ──
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_DB=0
REDIS_QUEUE_DB=1

# ── Laravel Horizon (Queue Monitoring) ──
HORIZON_PREFIX=horizon_
HORIZON_MEMORY=128
HORIZON_WORK_TIMEOUT=300
HORIZON_WORK_SLOW_TIMEOUT=60

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Google Analytics ──
ANALYTICS_PROPERTY_ID=123456789
GOOGLE_APPLICATION_CREDENTIALS="${APP_PATH}/storage/app/analytics/service-account-credentials.json"

# ── Mail (Development - Mailtrap) ──
# Sign up at https://mailtrap.io (free tier: 500 emails/month)
# Go to Email Testing → Inboxes → Your Inbox → Integration → Laravel
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your-mailtrap-username
MAIL_PASSWORD=your-mailtrap-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@yourportfolio.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Production Mail Options (Choose ONE) ──
# Option A - Amazon SES (recommended for scale)
# MAIL_MAILER=ses
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# AWS_DEFAULT_REGION=us-east-1

# Option B - Resend (modern, developer-friendly)
# MAIL_MAILER=resend
# RESEND_KEY=re_xxxxxxxxxxxxxx

# Option C - Plain SMTP (Gmail, SendGrid, Postmark, etc.)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=your-sendgrid-api-key
# MAIL_ENCRYPTION=tls

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

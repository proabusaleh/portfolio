# ── Production Environment Configuration ──
# Copy this file to .env and update the values for production deployment

APP_NAME=Your Portfolio
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── Database ──
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_production_db
DB_USERNAME=your_db_user
DB_PASSWORD=your_secure_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.yourdomain.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ── Queue (Production - Use Redis) ──
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# ── Redis Configuration ──
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=your_redis_password
REDIS_PORT=6379
REDIS_CACHE_DB=0
REDIS_QUEUE_DB=1

# ── Mail (Production - Choose ONE) ──
# Option A - Amazon SES (recommended for scale)
MAIL_MAILER=ses
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1

# Option B - Resend (modern, developer-friendly)
# MAIL_MAILER=resend
# RESEND_KEY=re_xxxxxxxxxxxxxx

# Option C - SMTP (SendGrid, Postmark, etc.)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=your-sendgrid-api-key
# MAIL_ENCRYPTION=tls

MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Laravel Horizon (Queue Monitoring) ──
HORIZON_PREFIX=horizon_
HORIZON_MEMORY=128
HORIZON_WORK_TIMEOUT=300
HORIZON_WORK_SLOW_TIMEOUT=60

# ── Security ──
# Generate these with: php artisan key:generate
# For session encryption
APP_KEY=base64:your-generated-key-here

# For Sanctum tokens
SANCTUM_STATEFUL_DOMAINS=yourdomain.com

# CORS Configuration
SANCTUM_TOKEN_EXPIRATION=525600

# ── Performance ──
# Enable OPCache for production
# Add to php.ini: opcache.enable=1
# Add to php.ini: opcache.memory_consumption=256
# Add to php.ini: opcache.interned_strings_buffer=16
# Add to php.ini: opcache.max_accelerated_files=10000
# Add to php.ini: opcache.revalidate_freq=2

# ── SSL/TLS ──
# Ensure your server has valid SSL certificates
# Set up proper SSL configuration in your web server (Nginx/Apache)

# ── Email Provider Specific Settings ──
# For AWS SES Webhooks
SES_WEBHOOK_SIGNATURE=your-webhook-signature-key

# For SendGrid
SENDGRID_API_KEY=your-sendgrid-api-key

# For Mailgun
MAILGUN_DOMAIN=your-mailgun-domain
MAILGUN_SECRET=your-mailgun-api-key
MAILGUN_ENDPOINT=api.mailgun.net